# 复制成 .env 后按需修改（docker compose 会自动读取同目录的 .env）
# 本文件只放示例值；真实私钥 / API key 只写进 .env（已被 .gitignore 忽略），切勿提交。

# 前端对外端口
FRONTEND_PORT=8080

# 后端对外端口（仅用于调试；生产可关掉）
BACKEND_PORT=8787

# 行情来源：polymarket（只用真盘）/ simulated（只用本地模拟）/ auto（上游连续失败自动降级）
# 填错会直接启动失败
MARKET_FEED=auto
# 开收盘价 / Gamma 轮询间隔（毫秒）；盘口走 WebSocket 时，轮询只负责订阅当前窗口与 REST 兜底
FEED_POLL_MS=5000
# 盘口实时推送：Polymarket CLOB market 频道 wss://ws-subscriptions-clob.polymarket.com；关掉则每轮 REST 拉账本
CLOB_WS=true

# ==================== 补充数据源（给策略 / LLM） ====================
# Binance 公开行情（1m K 线算波动、逐笔算主动买卖），默认官方只读镜像 data-api.binance.vision
# BINANCE_API_BASE=https://data-api.binance.vision
# Binance 合约强平流（开盘以来多空谁在被强平）
BINANCE_LIQUIDATIONS=true
# 逐笔流 wss://stream.binance.com:9443（策略开着就连）；Chainlink 逐秒现货走 Polymarket 实时数据流
# wss://ws-live-data.polymarket.com，真盘模式自动开启

# ==================== 自动策略 ====================
# 开了才会跑预测员回路；默认关
STRATEGY_ENABLED=false
# 启动后是否立刻开始下注（否则等 POST /api/strategy/switch {"on":true}）
STRATEGY_AUTOSTART=false
# 判官：math（纯数学随机游走基线，无需 key）/ jev（TypeSafe Jev）/ claude（Anthropic Claude）
STRATEGY_JUDGE=math
# 下单通道：paper（模拟盘，虚拟资金）/ live（Polymarket 实盘，另见下方实盘配置）
STRATEGY_BROKER=paper
# 开关接口的口令（请求头 x-admin-token）；不设则开关接口一律 403
STRATEGY_ADMIN_TOKEN=
# 每注本金、判官把握阈值、检查点（开盘后第几秒问一次）
STRATEGY_BASE_STAKE=5
STRATEGY_ACT_THRESHOLD=0.5
STRATEGY_CHECKPOINTS=30,45,60,75,90,105,120,135,150,165,180,195,210,225,240,255,270
# 判官拍板后等多久再看盘口（价没变差才成交）、盘口超龄阈值
STRATEGY_FILL_DELAY_MS=1000
STRATEGY_BOOK_MAX_AGE_MS=7000
# 数学判官：公平价比含费成本至少高出多少才买（0.03 = 3¢/份）
STRATEGY_MATH_MIN_EDGE=0.03

# Jev（STRATEGY_JUDGE=jev）
JEV_API_KEY=
# JEV_BASE_URL=https://api.typesafe.ai
# JEV_MODEL=jev-latest

# Claude（STRATEGY_JUDGE=claude）；也可用 ant auth login 的凭据
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5
# 每 15 秒一问，默认 low 控延迟与成本
CLAUDE_EFFORT=low

# ==================== 实盘（STRATEGY_BROKER=live） ====================
# 实盘需同时满足：LIVE_TRADING_ENABLED=true、MARKET_FEED=polymarket、配置私钥。
# 下单前会调用 Polymarket 官方 geoblock 接口，所在地区受限或检查失败一律不下单；
# 本项目不支持、也不提供任何绕过地域限制的方式。
LIVE_TRADING_ENABLED=false
# 默认 dry-run：只签名不提交，确认链路无误后再改成 false
LIVE_DRY_RUN=true
# 钱包私钥（仅内存使用，不落库不打日志）
POLY_PRIVATE_KEY=
# 0 = 普通钱包 EOA；1 = 邮箱/Magic 登录；2 = 浏览器钱包的 Polymarket 代理钱包（1/2 需填 funder）
POLY_SIGNATURE_TYPE=0
# Polymarket 个人资料里的充值地址（代理钱包地址）
POLY_FUNDER_ADDRESS=
# L2 API 凭据（可不填：用私钥自动派生）
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=
# 自动领奖：赢了的份额在链上 redeemPositions 换回 USDC（dry-run 下不领）
#   普通钱包（POLY_SIGNATURE_TYPE=0）：直接发交易，钱包里需要少量 POL 付 gas
#   代理 / Safe 钱包（1 / 2）：走 Polymarket 官方 relayer，免 gas，需要 Builder API 凭据
#   （在 Polymarket 的 Builder 设置里申请）；不填则不自动领，需到网页手动领
LIVE_AUTO_REDEEM=true
# POLYGON_RPC_URL=https://polygon-rpc.com
# POLY_RELAYER_URL=https://relayer-v2.polymarket.com
POLY_BUILDER_API_KEY=
POLY_BUILDER_SECRET=
POLY_BUILDER_PASSPHRASE=
# 风控：单笔上限、未了结仓位成本上限、UTC 当日亏损上限（USDC）
LIVE_MAX_STAKE_USD=5
LIVE_MAX_OPEN_COST_USD=20
LIVE_MAX_DAILY_LOSS_USD=20
